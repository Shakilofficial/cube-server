datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  description    String?
  specifications Json?             // shared spec sheet: display, processor, battery, camera, etc.
  brandId        String
  status         ProductStatus     @default(DRAFT)
  images         ProductImage[]    // generic/lifestyle images (colorId null)
  colors         ProductColor[]
  variants       ProductVariant[]
  categories     ProductCategory[]
  reviews        ProductReview[]
  metadata       Json?             // SEO fields, cached attributes
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  brand          Brand             @relation(fields: [brandId], references: [id])

  @@index([status, brandId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

// ─── Product Color ────────────────────────────────────────────────────────────
// Groups variants + images by color — selecting a color swaps the whole
// gallery, matching Amazon/Flipkart-style electronics PDPs.

model ProductColor {
  id        String           @id @default(uuid())
  productId String
  name      String           // e.g. "Titanium Blue"
  hexCode   String?          // for swatch rendering
  sortOrder Int              @default(0)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductImage[]
  variants  ProductVariant[]

  @@unique([productId, name])
}

// ─── Product Variant ──────────────────────────────────────────────────────────
// The actual sellable unit — one SKU, one price. Distinguished from siblings
// by colorId + attributes (storage, RAM, etc.).

model ProductVariant {
  id             String       @id @default(uuid())
  productId      String
  colorId        String
  sku            String       @unique
  price          Decimal      @db.Decimal(10, 2)
  compareAtPrice Decimal?     @db.Decimal(10, 2) // MRP shown struck-through when > price
  attributes     Json         // e.g. { "storage": "256GB", "ram": "8GB" }
  isDefault      Boolean      @default(false)    // pre-selected variant on the PDP
  isActive       Boolean      @default(true)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color          ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([productId])
  @@index([colorId])
}

// ─── Brand ────────────────────────────────────────────────────────────────────

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  website     String?
  seoTitle    String?
  seoDesc     String?
  products    Product[]
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id       String            @id @default(uuid())
  name     String
  slug     String            @unique
  iconUrl  String?
  parentId String?
  level    Int               @default(0)
  parent   Category?         @relation(name: "CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]        @relation(name: "CategoryHierarchy")
  products ProductCategory[]

  @@index([parentId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
}

// ─── Product Image ────────────────────────────────────────────────────────────

model ProductImage {
  id         String        @id @default(uuid())
  productId  String
  colorId    String?       // null = generic/lifestyle image not tied to a color
  url        String        // Original (max 2048px WebP)
  thumbSmUrl String        // 200×200 WebP
  thumbMdUrl String        // 400×400 WebP
  isPrimary  Boolean       @default(false)
  sortOrder  Int           @default(0)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      ProductColor? @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([colorId])
}

// ─── Product Review ───────────────────────────────────────────────────────────

model ProductReview {
  id               String              @id @default(uuid())
  productId        String
  userId           String
  rating           Int                 // 1–5
  comment          String?
  status           ReviewStatus        @default(PENDING)
  verifiedPurchase Boolean             @default(false)
  helpfulVotes     Int                 @default(0)
  createdAt        DateTime            @default(now())
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  votes            ReviewHelpfulVote[]

  @@unique([productId, userId]) // One review per user per product
  @@index([productId, status])
  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReviewHelpfulVote {
  userId   String
  reviewId String
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId])
}
