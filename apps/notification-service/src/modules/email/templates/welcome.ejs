<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Account Created Successfully</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Grift:wght@600;700&display=swap"
            rel="stylesheet"
        />

        <style type="text/css">
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body {
                background: #0a0a12;
                font-family: 'Manrope', system-ui, -apple-system, sans-serif;
                color: #e6e6f0;
                line-height: 1.6;
                margin: 0;
                padding: 40px 16px;
                -webkit-font-smoothing: antialiased;
            }
            .wrapper {
                max-width: 540px;
                margin: 0 auto;
            }
            .container {
                background: #131322;
                background-image: linear-gradient(180deg, #1c1c28 0%, #131322 100%);
                border: 1px solid rgba(106, 79, 255, 0.25);
                border-radius: 20px;
                padding: 40px 32px;
                text-align: center;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
                position: relative;
                overflow: hidden;
            }
            .accent-bar {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #6a4fff 0%, #32d1f4 100%);
            }
            .logo {
                display: block;
                margin: 12px auto 28px;
                max-width: 100%;
                filter: drop-shadow(0 4px 12px rgba(106, 79, 255, 0.2));
            }
            h2 {
                font-family: 'Grift', 'Manrope', sans-serif;
                font-size: 26px;
                font-weight: 700;
                color: #ffffff;
                margin: 0 0 16px;
                letter-spacing: -0.02em;
            }
            .greeting {
                font-size: 16px;
                color: #a2a2b0;
                margin-bottom: 16px;
            }
            .greeting strong {
                color: #8c78ff;
            }
            .message {
                font-size: 15px;
                color: #a2a2b0;
                margin: 0 0 32px;
                line-height: 1.7;
            }
            .badge-wrapper {
                margin: 24px 0 32px;
            }
            .badge {
                font-family: 'Grift', monospace;
                font-size: 18px;
                font-weight: 600;
                color: #32d1f4;
                background: rgba(50, 209, 244, 0.08);
                border: 1px solid rgba(50, 209, 244, 0.25);
                border-radius: 30px;
                padding: 8px 24px;
                display: inline-block;
                letter-spacing: 0.05em;
            }
            .btn {
                display: inline-block;
                background: linear-gradient(135deg, #6a4fff 0%, #563cd6 100%);
                color: #ffffff;
                padding: 14px 36px;
                border-radius: 12px;
                text-decoration: none;
                font-weight: 600;
                font-size: 16px;
                margin: 0 auto 32px;
                box-shadow: 0 8px 20px rgba(106, 79, 255, 0.3);
                transition: all 0.2s ease;
            }
            .note {
                font-size: 13.5px;
                color: #8e8e9f;
                margin: 0 0 32px;
            }
            .footer {
                font-size: 12px;
                color: #7b7b8f;
                border-top: 1px solid rgba(106, 79, 255, 0.15);
                padding-top: 24px;
            }
            .footer a {
                color: #8c78ff;
                text-decoration: none;
                margin: 0 6px;
            }
            .footer a:hover {
                text-decoration: underline;
            }
            @media (max-width: 600px) {
                .container {
                    padding: 32px 24px;
                }
                h2 {
                    font-size: 22px;
                }
                body {
                    padding: 20px 12px;
                }
            }
        </style>
    </head>
    <body>
        <div class="wrapper">
            <div class="container">
                <div class="accent-bar"></div>
                <img
                    class="logo"
                    src="https://res.cloudinary.com/dcyupktj6/image/upload/w_180,h_180,c_fit,q_auto,f_auto/v1770200775/uploads/iufo6oibhskziwgmloo3.png"
                    alt="<%= companyName %>"
                    width="80"
                    style="display: block; margin: 12px auto 28px; border: 0"
                />

                <h2>Congratulations & Welcome!</h2>

                <p class="greeting">Hi <strong><%= name %></strong>,</p>

                <p class="message">
                    We are thrilled to let you know that your account with <%= companyName %> has been successfully created and verified! You are now ready to explore our platforms and services.
                </p>

                <div class="badge-wrapper">
                    <div class="badge">Account Verified</div>
                </div>

                <a
                    href="<%= frontendUrl %>"
                    class="btn"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Get Started
                </a>

                <p class="note">
                    If you have any questions or need assistance, feel free to contact our support team at <%= supportEmail %>.
                </p>

                <div class="footer">
                    © <%= new Date().getFullYear() %> <%= companyName %><br />
                    <a href="<%= frontendUrl %>"><%= companyName %></a> ·
                    <a href="mailto:<%= supportEmail %>">Support</a>
                </div>
            </div>
        </div>
    </body>
</html>
